      "EmptyListItem": ""
     },
     "AlteracoesList": {
      "List": [],
      "EmptyListItem": ""
     },
     "Nivel": 1,
     "HasFilhos": false,
     "TodosFilhosRevogados": false,
     "DataEntradaVigorProximaVersao": "1900-01-01"
    },
    {
     "IsOpen": true,
     "IsHidden": false,
     "ConsolidacaoFragmento": {
      "Id": "75280958",
      "CreationDate": "2025-04-22T12:12:01Z",
