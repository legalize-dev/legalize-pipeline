# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Blob storage (Vercel Blob)
BLOB_STORE=vercel
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Rate limiting (requests per second per IP, API only)
RATE_LIMIT_RPS=1.0

# Connection pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# For local development (no Vercel Blob needed):
# BLOB_STORE=local
# BLOB_DIR=.blob
